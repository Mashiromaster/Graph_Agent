{
  "name": "graph-agent",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "smoke:harness": "npm run build && node scripts/harness-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
